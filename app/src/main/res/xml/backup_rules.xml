<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования для Android 11 и ниже.
   Пользовательские данные (база плейлистов и треков, настройки DataStore)
   копируются как есть. Исключается только то, что восстановится само:
   кеш манифеста каталога и устаревшие приватные копии скачанных треков.
   См. https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="author_manifest.json" />
    <exclude domain="file" path="downloads/" />
</full-backup-content>
